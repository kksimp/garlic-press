## Stream filters (ISO 32000-2 section 7.4). Image codecs (`DCTDecode`,
## `JPXDecode`, `CCITTFaxDecode`, `JBIG2Decode`) carry pixels, not text, so
## they are not needed for the text layer and fail as unsupported.

use std.compress

pub fn decode_filter(name str, data List[int], parms Map[str, Obj]) List[int] ! PdfError
    match name
        "FlateDecode" | "Fl" => predict(flate(data)?, parms)
        "LZWDecode" | "LZW" => predict(
            lzw(data, (parms.get("EarlyChange")?.as_int() else 1) == 1),
            parms,
        )
        "ASCIIHexDecode" | "AHx" => ascii_hex(data)
        "ASCII85Decode" | "A85" => ascii85(data)
        "RunLengthDecode" | "RL" => run_length(data)
        "Crypt" => data
        _ => Unsupported(what: "the {name} filter")

## FlateDecode (7.4.4): std.compress first, and on any error the in-house
## `inflate_zlib`, which keeps what decoded before damage and skips the
## Adler-32 check, as truncated or misflagged real-world streams need.
fn flate(data List[int]) List[int] ! PdfError
    raw := compress.unzlib(bytes.from_list([v.to_u8() for v in data])) else
        return inflate_zlib(data)
    [v.to_int() for v in raw.to_list()]

## PNG and TIFF predictors after Flate or LZW (7.4.4.4).
fn predict(data List[int], parms Map[str, Obj]) List[int] ! PdfError
    p := parms.get("Predictor")?.as_int() else 1
    if p < 2
        return data
    colors := parms.get("Colors")?.as_int() else 1
    bpc := parms.get("BitsPerComponent")?.as_int() else 8
    cols := parms.get("Columns")?.as_int() else 1
    bpp := (colors * bpc + 7) / 8
    row := (colors * bpc * cols + 7) / 8
    if p == 2
        if bpc != 8
            return Unsupported(what: "TIFF predictor with {bpc} bits per component")
        mut out := data
        mut i := 0
        while i < out.len()
            for j in bpp..row
                if i + j < out.len()
                    out[i + j] = (out[i + j] + out[i + j - bpp]) % 256
            i += row
        return out
    mut out := List[int]()
    mut prev := [0 for _ in 0..row]
    mut i := 0
    while i < data.len()
        kind := data[i]
        i += 1
        mut cur := [0 for _ in 0..row]
        for j in 0..row
            raw := if i + j < data.len() then data[i + j] else 0
            left := if j >= bpp then cur[j - bpp] else 0
            up := prev[j]
            ul := if j >= bpp then prev[j - bpp] else 0
            v := match kind
                0 => raw
                1 => raw + left
                2 => raw + up
                3 => raw + (left + up) / 2
                4 => raw + paeth(left, up, ul)
                _ => return Bad(why: "PNG predictor type {kind}")
            cur[j] = v % 256
        out.extend(cur)
        prev = cur
        i += row
    out

fn paeth(a int, b int, c int) int
    p := a + b - c
    pa := (p - a).abs()
    pb := (p - b).abs()
    pc := (p - c).abs()
    if pa <= pb and pa <= pc then a else if pb <= pc then b else c

fn ascii_hex(data List[int]) List[int]
    mut b := [60]
    b.extend(data)
    mut l := Lexer.new(b, 0)
    (l.token() else Obj.Null).as_bytes() else []

## ASCII base-85, `z` for four zeros, ending at `~>` (7.4.3).
fn ascii85(data List[int]) List[int] ! PdfError
    mut out := List[int]()
    mut group := List[int]()
    mut i := 0
    while i < data.len()
        c := data[i]
        i += 1
        if c == 126
            break
        if is_white(c)
            continue
        if c == 122 and group.len() == 0
            out.extend([0, 0, 0, 0])
            continue
        if c < 33 or c > 117
            return Bad(why: "bad ASCII85 character {c}")
        group.push(c - 33)
        if group.len() == 5
            out.extend(base85_word(group, 4))
            group = []
    if group.len() > 0
        n := group.len() - 1
        while group.len() < 5
            group.push(84)
        out.extend(base85_word(group, n))
    out

fn base85_word(g List[int], n int) List[int]
    mut v := 0
    for d in g
        v = v * 85 + d
    [v.shr(24).bit_and(255), v.shr(16).bit_and(255), v.shr(8).bit_and(255), v.bit_and(255)].take(n)

## LZW with 9- to 12-bit codes, MSB first (7.4.4.2).
fn lzw(data List[int], early bool) List[int]
    mut out := List[int]()
    mut table := [[i] for i in 0..256]
    table.push([])
    table.push([])
    mut width := 9
    mut prev := List[int]()
    mut acc := 0
    mut nbits := 0
    mut i := 0
    while true
        while nbits < width and i < data.len()
            acc = acc * 256 + data[i]
            i += 1
            nbits += 8
        if nbits < width
            break
        code := acc.shr(nbits - width).bit_and(1.shl(width) - 1)
        nbits -= width
        acc = acc.bit_and(1.shl(nbits) - 1)
        if code == 256
            table = table.take(258)
            width = 9
            prev = []
            continue
        if code == 257
            break
        mut entry := List[int]()
        if code < table.len()
            entry = table[code]
            if prev.len() > 0
                mut e := prev
                e.push(entry[0])
                table.push(e)
        elif prev.len() > 0
            entry = prev
            entry.push(prev[0])
            table.push(entry)
        else
            break
        out.extend(entry)
        prev = entry
        bump := if early then 1 else 0
        if table.len() + bump >= 1.shl(width) and width < 12
            width += 1
    out

fn run_length(data List[int]) List[int]
    mut out := List[int]()
    mut i := 0
    while i < data.len()
        n := data[i]
        i += 1
        if n == 128
            break
        if n < 128
            out.extend(data[i..(i + n + 1).min(data.len())])
            i += n + 1
        else
            if i < data.len()
                for _ in 0..257 - n
                    out.push(data[i])
            i += 1
    out

@test fn decodes_ascii_filters() !
    assert_eq(latin1(decode_filter("AHx", ascii("48 65 6c6C6f>"), {})?), "Hello")
    assert_eq(latin1(decode_filter("A85", ascii("87cURD]i,\"Ebo80~>"), {})?), "Hello World!")
    assert_eq(decode_filter("RL", [2, 1, 2, 3, 254, 9, 128], {})?, [1, 2, 3, 9, 9, 9])

@test fn decodes_lzw() !
    # The example of 7.4.4.2: 45 45 45 45 45 65 45 45 45 66.
    enc := [128, 11, 96, 80, 34, 12, 12, 133, 1]
    assert_eq(decode_filter("LZW", enc, {})?, [45, 45, 45, 45, 45, 65, 45, 45, 45, 66])

@test fn undoes_png_up_predictor() !
    rows := [2, 1, 2, 2, 1, 1]
    p := {"Predictor": Obj.Int(n: 12), "Columns": Obj.Int(n: 2)}
    assert_eq(predict(rows, p)?, [1, 2, 2, 3])

@test fn flate_agrees_with_the_in_house_inflater() !
    # zlib streams: "hello" stored and fixed, a back reference, and std's own output.
    long := ascii("The office tracks every invoice. ".repeat(40))
    own := [v.to_int() for v in compress.zlib(bytes.from_list([v.to_u8() for v in long])).to_list()]
    fixtures := [
        [120, 1, 1, 5, 0, 250, 255, 104, 101, 108, 108, 111, 6, 44, 2, 21],
        [120, 156, 203, 72, 205, 201, 201, 7, 0, 6, 44, 2, 21],
        [120, 218, 75, 76, 74, 78, 68, 69, 0, 65, 124, 6, 229],
        own,
    ]
    for z in fixtures
        std := [
            v.to_int()
            for v in compress.unzlib(bytes.from_list([v.to_u8() for v in z]))?.to_list()
        ]
        assert_eq(std, inflate_zlib(z)?)
        assert_eq(decode_filter("FlateDecode", z, {})?, std)
    assert_eq(decode_filter("Fl", own, {})?, long)

@test fn flate_falls_back_on_a_bad_checksum() !
    # "hello" at level 6 with the last Adler-32 byte changed (21 -> 22).
    bad := [120, 156, 203, 72, 205, 201, 201, 7, 0, 6, 44, 2, 22]
    strict := compress.unzlib(bytes.from_list([v.to_u8() for v in bad])) else b""
    assert_eq(strict.len(), 0)
    assert_eq(latin1(decode_filter("FlateDecode", bad, {})?), "hello")
