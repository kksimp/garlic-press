## Glyph recognition by nearest reference shape (ADR 0512). A glyph's
## features are its ink on an 8 by 8 grid stretched over its box, its
## outline's left, right, top and bottom edges on 6 by 6 grids (stroke
## direction, which varies less between fonts than exact ink), and its
## width, height, top and bottom against its line's baseline and text size.
## Reference shapes come from fonts drawn by `image.Canvas` through the same
## layout code (`pdf train`), so page glyphs and references are measured
## alike. One matrix product scores a page's glyphs against every shape.

use std.tensor

GRID := 8

EDGE := 6

## Features before the geometry: ink, then the four edge grids.
SHAPE := GRID * GRID + 4 * EDGE * EDGE

## How much the four geometry features weigh against the shape.
GEOMETRY := 8.0

pub fn dims() int
    SHAPE + 4

## Adds `v` at fractional cell (`fx`, `fy`) of a grid `n` cells wide with
## a one-cell border, shared among the four nearest cell centres.
fn spread(mut cells List[float], n int, fx float, fy float, v float)
    side := n + 2
    cx := fx.floor().to_int()
    cy := fy.floor().to_int()
    wx := fx - cx.to_float()
    wy := fy - cy.to_float()
    i := (cy + 1) * side + cx + 1
    cells[i] += v * (1.0 - wx) * (1.0 - wy)
    cells[i + 1] += v * wx * (1.0 - wy)
    cells[i + side] += v * (1.0 - wx) * wy
    cells[i + side + 1] += v * wx * wy

## Pixels of run `r` not covered by any run in `other`, as [x0, x1) pieces.
fn uncovered(r Run, other List[Run]) List[List[int]]
    mut out := List[List[int]]()
    mut x := r.x0
    for o in other
        if o.x1 <= x or o.x0 >= r.x1
            continue
        if o.x0 > x
            out.push([x, o.x0])
        x = x.max(o.x1)
    if x < r.x1
        out.push([x, r.x1])
    out

## Adds the pixels `x0..x1` of a row to a fine grid `n` cells wide (two
## per feature cell) by how much of each fine column they cover, divided
## by `per`; this costs per run, not per pixel.
fn cover(mut fine List[float], at int, n int, row int, x0 int, x1 int, w int, per float)
    k := n.to_float() / w.to_float()
    a := x0.to_float() * k
    b := x1.to_float() * k
    mut c := a.floor().to_int()
    while c.to_float() < b and c < n
        lo := a.max(c.to_float())
        hi := b.min((c + 1).to_float())
        fine[at + row * n + c] += (hi - lo) / k / per
        c += 1

## Fine cells: the ink grid and four edge grids at twice the resolution.
fn fine_dims() int
    4 * GRID * GRID + 16 * EDGE * EDGE

## Adds a glyph's fine grids at `base` of `fine`, each cell already
## divided by its normaliser: ink by a feature cell's pixels, edges by a
## feature cell's side.
fn add_fine(mut fine List[float], base int, b Blob)
    w := b.w()
    h := b.h()
    gn := GRID * 2
    en := EDGE * 2
    edge_at := base + gn * gn
    fw := w.to_float()
    fh := h.to_float()
    ink := fw * fh / (GRID * GRID).to_float()
    side := (fh / EDGE.to_float()).max(1.0)
    top := (fw / EDGE.to_float()).max(1.0)
    mut by_row := Map[int, List[Run]]()
    for r in b.runs
        by_row.push(r.y, r)
    for r in b.runs
        y := r.y - b.y0
        gy := y * gn / h
        ey := y * en / h
        x0 := r.x0 - b.x0
        x1 := r.x1 - b.x0
        cover(mut fine, base, gn, gy, x0, x1, w, ink)
        cover(mut fine, edge_at, en, ey, x0, x0 + 1, w, side)
        cover(mut fine, edge_at + en * en, en, ey, x1 - 1, x1, w, side)
        for piece in uncovered(r, by_row.get(r.y - 1) else [])
            cover(mut fine, edge_at + 2 * en * en, en, ey, piece[0] - b.x0, piece[1] - b.x0, w, top)
        for piece in uncovered(r, by_row.get(r.y + 1) else [])
            cover(mut fine, edge_at + 3 * en * en, en, ey, piece[0] - b.x0, piece[1] - b.x0, w, top)

## The constant map from fine cells to feature cells: each fine cell
## shares itself among the four nearest feature cell centres (soft
## binning, so a stroke a pixel off moves the features a little instead
## of jumping cells).
fn binning() List[float]
    nf := fine_dims()
    mut m := [0.0 for _ in 0..nf * SHAPE]
    mut f_at := 0
    mut s_at := 0
    for n in [GRID, EDGE, EDGE, EDGE, EDGE]
        fn2 := n * 2
        for fy in 0..fn2
            for fx in 0..fn2
                mut cells := [0.0 for _ in 0..(n + 2) * (n + 2)]
                spread(
                    mut cells,
                    n,
                    (fx.to_float() + 0.5) / 2.0 - 0.5,
                    (fy.to_float() + 0.5) / 2.0 - 0.5,
                    1.0,
                )
                for cy in 0..n
                    for cx in 0..n
                        m[(f_at + fy * fn2 + fx) * SHAPE + s_at + cy * n + cx] = cells[(cy + 1) * (n + 2) + cx + 1]
        f_at += fn2 * fn2
        s_at += n * n
    m

## The features of many glyphs at once: their fine grids through the
## binning map in one matrix product, capped at 1, then the geometry.
pub fn features_of(glyphs List[Blob], lines List[GlyphLine]) List[List[float]]
    if glyphs.len() == 0
        return []
    nf := fine_dims()
    mut flat := tensor.zeros([glyphs.len() * nf]).to_list()
    for i in 0..glyphs.len()
        add_fine(mut flat, i * nf, glyphs[i])
    shaped := tensor.from(flat, [glyphs.len(), nf]).matmul(tensor.from(binning(), [nf, SHAPE]))
    # min(v, 1) = 1 - relu(1 - v)
    capped := ((shaped * -1.0 + 1.0).relu() * -1.0 + 1.0).to_list()
    mut out := List[List[float]]()
    for i in 0..glyphs.len()
        b := glyphs[i]
        l := lines[i]
        mut row := capped[i * SHAPE..(i + 1) * SHAPE]
        s := l.size.to_float()
        row.push(GEOMETRY * b.w().to_float() / s)
        row.push(GEOMETRY * b.h().to_float() / s)
        row.push(GEOMETRY * (l.base - b.y0).to_float() / s)
        row.push(GEOMETRY * (l.base - b.y1).to_float() / s)
        out.push(row)
    out

## The features of glyph `b` on line `l`.
pub fn features(b Blob, l GlyphLine) List[float]
    features_of([b], [l])[0]

## Reference shapes: a label and its feature row each.
pub struct Shapes
    pub labels List[str]
    pub rows List[float]

## Reads shapes saved by `Shapes.save`: one per line, the label's code
## points in hex joined by `+`, a space, then each feature as two hex
## digits (the grid's ink in 255ths, the geometry in 64ths of the size,
## unweighted, so `GEOMETRY` can change without redrawing).
pub fn Shapes.load(text str) Shapes
    mut labels := List[str]()
    mut rows := List[float]()
    n := dims()
    for line in text.split("\n")
        t := line.trim()
        if t == ""
            continue
        parts := t.split(" ")
        if parts.len() != 2 or parts[1].len() != n * 2
            continue
        mut label := ""
        for c in parts[0].split("+")
            label = "{label}{char.from_code(hex(c)) else '?'}"
        labels.push(label)
        hx := parts[1].chars()
        for i in 0..n
            v := (digit(hx[i * 2]) * 16 + digit(hx[i * 2 + 1])).to_float()
            rows.push(if i < SHAPE then v / 255.0 else v / 64.0 * GEOMETRY)
    Shapes(labels: labels, rows: rows)

fn hex(s str) int
    mut v := 0
    for c in s.chars()
        v = v * 16 + digit(c)
    v

fn digit(c char) int
    d := c.code()
    if d <= 57 then d - 48 else d - 87

fn hex2(v int) str
    digits := "0123456789abcdef".chars()
    x := v.max(0).min(255)
    "{digits[x / 16]}{digits[x % 16]}"

pub fn Shapes.save(self) str
    n := dims()
    mut out := List[str]()
    for i in 0..labels.len()
        code := [c.code().to_hex() for c in labels[i].chars()].join("+")
        mut hx := List[str]()
        for k in 0..n
            v := rows[i * n + k]
            hx.push(hex2(if k < SHAPE then (v * 255.0).round().to_int() else (v / GEOMETRY * 64.0).round().to_int()))
        out.push("{code} {hx.join("")}")
    out.join("\n")

## A glyph's best label, how sure it is (0 to 1), and its distance.
pub struct Guess
    pub label str
    pub sure float
    pub dist float

## The nearest shape's label for each feature row, by Euclidean distance:
## |f - p|^2 = |f|^2 + |p|^2 - 2 f.p, the products in one matmul.
pub fn Shapes.classify(self, feats List[List[float]]) List[Guess]
    n := dims()
    m := labels.len()
    if feats.len() == 0 or m == 0
        return []
    mut flat := List[float]()
    for f in feats
        flat.extend(f)
    dots := tensor
        .from(flat, [feats.len(), n])
        .matmul(tensor.from(rows, [m, n]).transpose())
        .to_list()
    mut norms := List[float]()
    for j in 0..m
        mut s := 0.0
        for k in 0..n
            s += rows[j * n + k] * rows[j * n + k]
        norms.push(s)
    mut out := List[Guess]()
    for i in 0..feats.len()
        mut fn2 := 0.0
        for v in feats[i]
            fn2 += v * v
        mut best := -1
        mut bd := 1.0e18
        for j in 0..m
            d := norms[j] - 2.0 * dots[i * m + j]
            if d < bd
                bd = d
                best = j
        # The nearest shape with another label sets the margin.
        mut second := 1.0e18
        for j in 0..m
            if labels[j] != labels[best]
                d := norms[j] - 2.0 * dots[i * m + j]
                if d < second
                    second = d
        d1 := (bd + fn2).max(0.0).sqrt()
        d2 := (second + fn2).max(0.0).sqrt()
        sure := if d2 > 0.0 then ((d2 - d1) / d2).max(0.0).min(1.0) else 0.0
        out.push(Guess(label: labels[best], sure: sure, dist: d1))
    out

@test fn saves_and_loads_shapes()
    row := [0.0 for _ in 0..dims()]
    mut r := row
    r[0] = 1.0
    r[dims() - 1] = 0.5
    mut rows := row
    rows.extend(r)
    s := Shapes(labels: ["a", "é"], rows: rows)
    back := Shapes.load(s.save())
    assert_eq(back.labels, ["a", "é"])
    assert_eq(back.rows, s.rows)
    gs := back.classify([r])
    assert_eq(gs[0].label, "é")
