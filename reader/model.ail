## The page model agents query (ADR 0520): each page's lines with their
## boxes, links, image count and what could not be read, plus the outline.
## It derives `ToJson`, so `pdf json` is this model as JSON.

pub struct Box
    pub x0 float
    pub y0 float
    pub x1 float
    pub y1 float

impl ToJson for Box

pub struct TextLine
    pub text str
    pub x float
    pub y float
    pub size float
    pub right float

impl ToJson for TextLine

pub struct Link
    pub rect Box
    pub uri str?
    pub page int?

impl ToJson for Link

pub struct PageModel
    pub page int
    pub width float
    pub height float
    pub rotate int
    pub lines List[TextLine]
    pub links List[Link]
    pub images int
    ## Glyphs whose font gives no text: the honest gap OCR would fill.
    pub unreadable int
    ## True when the page paints images and no text: a scan, which needs OCR.
    pub image_only bool

impl ToJson for PageModel

pub struct OutlineItem
    pub title str
    pub depth int
    pub page int?

impl ToJson for OutlineItem

## Rounds to 0.01 pt, which is finer than any glyph and keeps JSON short.
pub fn r2(x float) float
    (x * 100.0).round() / 100.0

## A page model plus the line geometry search needs.
pub struct Page
    pub model PageModel
    pub lines List[Line]

## PDFDocEncoding codes 0x80..0xA0 (Annex D.2); the rest is Latin-1.
PDFDOC_HIGH := [
    0x2022,
    0x2020,
    0x2021,
    0x2026,
    0x2014,
    0x2013,
    0x0192,
    0x2044,
    0x2039,
    0x203a,
    0x2212,
    0x2030,
    0x201e,
    0x201c,
    0x201d,
    0x2018,
    0x2019,
    0x201a,
    0x2122,
    0xfb01,
    0xfb02,
    0x0141,
    0x0152,
    0x0160,
    0x0178,
    0x017d,
    0x0131,
    0x0142,
    0x0153,
    0x0161,
    0x017e,
    0xfffd,
    0x20ac,
]

## A text string (7.9.2.2): UTF-16BE or UTF-8 with a byte order mark, else
## PDFDocEncoding.
pub fn text_string(b List[int]) str
    if b.len() >= 2 and b[0] == 0xfe and b[1] == 0xff
        mut u := List[int]()
        mut i := 2
        while i + 1 < b.len()
            u.push(b[i] * 256 + b[i + 1])
            i += 2
        return utf16(u)
    if b.len() >= 3 and b[0] == 0xef and b[1] == 0xbb and b[2] == 0xbf
        return utf8(b[3..])
    [chr(if c >= 0x80 and c <= 0xa0 then PDFDOC_HIGH[c - 0x80] else c) for c in b].join("")

## UTF-8 bytes as text; a bad sequence gives U+FFFD.
pub fn utf8(b List[int]) str
    mut out := List[char]()
    mut i := 0
    while i < b.len()
        c := b[i]
        mut n := 0
        mut v := c
        if c >= 0xf0
            n = 3
            v = c.bit_and(7)
        elif c >= 0xe0
            n = 2
            v = c.bit_and(15)
        elif c >= 0xc0
            n = 1
            v = c.bit_and(31)
        elif c >= 0x80
            v = 0xfffd
        if n > 0 and i + n >= b.len()
            out.push(chr(0xfffd))
            break
        for k in 1..n + 1
            v = v * 64 + b[i + k].bit_and(63)
        out.push(chr(v))
        i += n + 1
    out.join("")

## Page object numbers in order, for links and outline entries that point
## at a page.
fn Doc.page_numbers(self, pages List[Map[str, Obj]]) Map[int, int]
    mut m := Map[int, int]()
    for i in 0..pages.len()
        n := pages[i].get("_num")?.as_int() else 0
        if n > 0
            m[n] = i + 1
    m

## The page a destination names (12.3.2): an array whose first element is a
## page, a name or string looked up in the catalog's `/Dests` or `/Names`
## tree, or a dictionary with `/D`.
fn Doc.dest_page(self, dest Obj, nums Map[int, int], depth int) int?
    if depth > 8
        return none
    d := resolve(dest)
    if arr := d.as_arr()
        if arr.len() > 0
            if num := arr[0].as_ref()
                return nums.get(num)
            if i := arr[0].as_int()
                return i + 1
        return none
    if dd := d.as_dict()
        return dest_page(dd.get("D") else Obj.Null, nums, depth + 1)
    mut name := ""
    if n := d.as_name()
        name = n
    elif s := d.as_bytes()
        name = latin1(s)
    else
        return none
    root := key(trailer, "Root").as_dict() else return none
    if old := key(root, "Dests").as_dict()
        if v := old.get(name)
            return dest_page(v, nums, depth + 1)
    names := key(root, "Names").as_dict() else return none
    tree := key(names, "Dests")
    v := name_tree(tree, name, 0) else return none
    dest_page(v, nums, depth + 1)

fn Doc.name_tree(self, node Obj, name str, depth int) Obj?
    if depth > 32
        return none
    d := resolve(node).as_dict() else return none
    if ns := key(d, "Names").as_arr()
        mut i := 0
        while i + 1 < ns.len()
            if latin1(resolve(ns[i]).as_bytes() else []) == name
                return ns[i + 1]
            i += 2
    for kid in key(d, "Kids").as_arr() else []
        if v := name_tree(kid, name, depth + 1)
            return v
    none

fn Doc.links(self, page Map[str, Obj], nums Map[int, int], dx float, dy float) List[Link]
    mut out := List[Link]()
    for a in key(page, "Annots").as_arr() else []
        d := resolve(a).as_dict() else continue
        if key(d, "Subtype").as_name() != "Link"
            continue
        r := [resolve(x).as_num() else 0.0 for x in (key(d, "Rect").as_arr() else [])]
        if r.len() != 4
            continue
        rect := Box(
            x0: r2(r[0].min(r[2]) - dx),
            y0: r2(r[1].min(r[3]) - dy),
            x1: r2(r[0].max(r[2]) - dx),
            y1: r2(r[1].max(r[3]) - dy),
        )
        out.push(Link(rect: rect, uri: link_uri(d), page: target_page(d, nums)))
    out

fn Doc.link_uri(self, d Map[str, Obj]) str?
    act := key(d, "A").as_dict() else return none
    if key(act, "S").as_name() != "URI"
        return none
    latin1(key(act, "URI").as_bytes() else [])

## The page a link or outline item goes to: `/Dest`, or a `GoTo` action.
fn Doc.target_page(self, d Map[str, Obj], nums Map[int, int]) int?
    if dest := d.get("Dest")
        return dest_page(dest, nums, 0)
    act := key(d, "A").as_dict() else return none
    if key(act, "S").as_name() != "GoTo"
        return none
    dest_page(act.get("D") else Obj.Null, nums, 0)

## The document outline (bookmarks), depth first (12.3.3).
pub fn Doc.outline(self) List[OutlineItem]
    mut out := List[OutlineItem]()
    root := key(trailer, "Root").as_dict() else return out
    ol := key(root, "Outlines").as_dict() else return out
    pages := pages() else []
    nums := page_numbers(pages)
    mut seen := Set[int]()
    outline_items(ol.get("First") else Obj.Null, 0, nums, mut out, mut seen)
    out

fn Doc.outline_items(
    self,
    first Obj,
    depth int,
    nums Map[int, int],
    mut out List[OutlineItem],
    mut seen Set[int],
)
    mut node := first
    while depth < 32
        num := node.as_ref() else return
        if not seen.add(num)
            return
        d := resolve(node).as_dict() else return
        title := text_string(key(d, "Title").as_bytes() else [])
        out.push(OutlineItem(title: title, depth: depth, page: target_page(d, nums)))
        if kid := d.get("First")
            outline_items(kid, depth + 1, nums, mut out, mut seen)
        node = d.get("Next") else return

## Every page, read (1-based numbers). A page that fails to read is empty.
pub fn Doc.read_pages(self) List[Page] ! PdfError
    ps := lazy_pages()?
    [ps.get(i) for i in 0..ps.count()]

struct PageCache
    pages Map[int, Page]

## The pages of a document, each read the first time it is asked for
## (ADR 0511): opening costs the page tree only, and a viewer or a search
## that stops early never reads the rest.
pub struct Pages
    doc Doc
    dicts List[Map[str, Obj]]
    nums Map[int, int]
    cache ref PageCache

pub fn Doc.lazy_pages(self) Pages ! PdfError
    dicts := pages()?
    Pages(doc: self, dicts: dicts, nums: page_numbers(dicts), cache: ref PageCache(pages: {}))

pub fn Pages.count(self) int
    dicts.len()

## Page `i` (0-based), read once.
pub fn Pages.get(self, i int) Page
    if p := cache.pages.get(i)
        return p
    p := doc.read_page(dicts[i], i + 1, nums)
    cache.pages[i] = p
    p

## Pages already read, for tests and tools that build pages themselves.
pub fn pages_of(list List[Page]) Pages
    doc := Doc(buf: [], xref: {}, trailer: {}, cache: ref Cache(objs: {}), repaired: false)
    mut m := Map[int, Page]()
    for i in 0..list.len()
        m[i] = list[i]
    Pages(
        doc: doc,
        dicts: [Map[str, Obj]() for _ in list],
        nums: {},
        cache: ref PageCache(pages: m),
    )

## How many pages have been read so far.
pub fn Pages.read_count(self) int
    cache.pages.len()

## Whether page `i` has been read.
pub fn Pages.is_read(self, i int) bool
    cache.pages.contains(i)

## A line in page coordinates: from the crop box's lower left corner.
fn shift(l Line, dx float, dy float) Line
    Line(
        text: l.text,
        x: l.x - dx,
        y: l.y - dy,
        size: l.size,
        starts: [v - dx for v in l.starts],
        ends: [v - dx for v in l.ends],
    )

pub fn Doc.read_page(self, p Map[str, Obj], number int, nums Map[int, int]) Page
    mb := [
        resolve(x).as_num() else 0.0
        for x in (key(p, "CropBox").as_arr() else (key(p, "MediaBox").as_arr() else []))
    ]
    box := if mb.len() == 4 then mb else [0.0, 0.0, 612.0, 792.0]
    pt := page_glyphs(p) else PageText(glyphs: [], images: 0)
    lines := [shift(l, box[0], box[1]) for l in lines_of(pt.glyphs)]
    mut unreadable := 0
    for g in pt.glyphs
        if not g.known
            unreadable += 1
    tl := [
        TextLine(text: l.text, x: r2(l.x), y: r2(l.y), size: r2(l.size), right: r2(l.right()))
        for l in lines
    ]
    model := PageModel(
        page: number,
        width: r2((box[2] - box[0]).abs()),
        height: r2((box[3] - box[1]).abs()),
        rotate: key(p, "Rotate").as_int() else 0,
        lines: tl,
        links: links(p, nums, box[0], box[1]),
        images: pt.images,
        unreadable: unreadable,
        image_only: pt.images > 0 and pt.glyphs.len() == 0,
    )
    Page(model: model, lines: lines)

## A US Letter page of left-aligned 10 pt lines 14 pt apart from the top,
## 5 pt per character: for tests of what reads pages.
pub fn text_page(number int, texts List[str]) Page
    mut lines := List[Line]()
    for i in 0..texts.len()
        n := texts[i].chars().len()
        y := 720.0 - 14.0 * i.to_float()
        lines.push(Line(
            text: texts[i],
            x: 72,
            y: y,
            size: 10,
            starts: [72.0 + 5.0 * k.to_float() for k in 0..n],
            ends: [77.0 + 5.0 * k.to_float() for k in 0..n],
        ))
    tl := [TextLine(text: l.text, x: l.x, y: l.y, size: l.size, right: l.right()) for l in lines]
    m := PageModel(
        page: number,
        width: 612,
        height: 792,
        rotate: 0,
        lines: tl,
        links: [],
        images: 0,
        unreadable: 0,
        image_only: false,
    )
    Page(model: m, lines: lines)

@test fn decodes_text_strings()
    assert_eq(text_string([0xfe, 0xff, 0, 0x48, 0, 0xe9]), "H\u{e9}")
    assert_eq(text_string([0xef, 0xbb, 0xbf, 0x63, 0xc3, 0xa9]), "c\u{e9}")
    assert_eq(text_string([0x41, 0x93, 0x84]), "A\u{fb01}\u{2014}")
